VITE_VERSION=1.4.0
VITE_API_MODE=

# The /exec URL of the Apps Script deployment. Users then log in with an account from the _Users tab.
VITE_APPS_SCRIPT_URL=

# Default invitation domain for new events (Link_Undangan = {domain}/{slug}/{PIN}).
VITE_INVITATION_DOMAIN=https://undangan.by.me
# WhatsApp number for the landing page's "Pesan via WhatsApp" buttons (08xx or +628xx). Empty: the buttons link to /portfolio.
VITE_ORDER_WHATSAPP=
