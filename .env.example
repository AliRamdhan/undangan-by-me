# The /exec URL of the Apps Script deployment (required). The app always talks to it;
# users log in with an account from the _Users tab. Use .env for dev, .env.production for builds.
VITE_APPS_SCRIPT_URL=
# Default invitation domain for new events (Link_Undangan = {domain}/{slug}/{PIN}).
VITE_INVITATION_DOMAIN=https://undangan.by.me
